{
	servers {
		strict_sni_host on
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

{$SBVZ_PUBLIC_API_HOST} {
	import security_headers

	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /run/sbvz-tls/internal-api-client-ca.pem
			}
		}
	}

	@api path /v1/*
	handle @api {
		reverse_proxy api:8080 {
			health_uri /health
			health_interval 5s
			health_timeout 5s
			health_fails 2
			health_headers {
				Host {$SBVZ_PUBLIC_API_HOST}
			}
		}
	}

	respond 404
}

{$SBVZ_PUBLIC_PORTAL_HOST} {
	import security_headers

	@portal path /portal/audit /portal/audit/* /portal.css
	handle @portal {
		reverse_proxy api:8080 {
			health_uri /health
			health_interval 5s
			health_timeout 5s
			health_fails 2
			health_headers {
				Host {$SBVZ_PUBLIC_PORTAL_HOST}
			}
		}
	}

	@health path /health /health/ready
	handle @health {
		reverse_proxy api:8080
	}

	respond 404
}
