ASPNETCORE_ENVIRONMENT=Development
SBVZ_SECRET_DIRECTORY=/absolute/path/to/sbvz/certificates/test
SBVZ_MODE=Mock
SBVZ_SUBSCRIBER_NUMBER=
SBVZ_TIMEOUT_SECONDS=30
SBVZ_CLIENT_CERTIFICATE_PATH=/absolute/path/to/sbvz/certificates/test/client.pfx
SBVZ_CLIENT_CERTIFICATE_PASSWORD=
SBVZ_CLIENT_CERTIFICATE_PASSWORD_FILE=/absolute/path/to/sbvz/certificates/test/client-certificate-password
SBVZ_API_KEY=
SBVZ_API_KEY_FILE=/absolute/path/to/sbvz/certificates/test/api-key
SBVZ_AUDIT_S3_BUCKET=
SBVZ_AUDIT_S3_ENDPOINT=https://s3-compatible-storage.example
SBVZ_AUDIT_S3_REGION=region-name
SBVZ_AUDIT_S3_ACCESS_KEY_ID=
SBVZ_AUDIT_S3_ACCESS_KEY_ID_FILE=
SBVZ_AUDIT_S3_SECRET_ACCESS_KEY=
SBVZ_AUDIT_S3_SECRET_ACCESS_KEY_FILE=
SBVZ_AUDIT_PATIENT_REFERENCE_KEY_ID=test-v1
SBVZ_AUDIT_PATIENT_REFERENCE_KEY=
SBVZ_AUDIT_PATIENT_REFERENCE_KEY_FILE=
